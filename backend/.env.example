# Template for backend/.env — copy this file to .env and fill in real values.
#
# This file IS committed; .env is NOT (see .gitignore). That's the standard
# pattern: the repo documents *which* settings exist without leaking their values.

# The `+psycopg` part selects the driver. Plain `postgresql://` makes SQLAlchemy
# reach for psycopg2, which we deliberately did not install -> ModuleNotFoundError.
DATABASE_URL=postgresql+psycopg://fliptrack:dev@localhost:5432/fliptrack

# Signs JWTs. Any leak lets an attacker mint tokens for any user.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Origins allowed to call the API from a browser. Vite dev server default.
CORS_ORIGINS=http://localhost:5173
